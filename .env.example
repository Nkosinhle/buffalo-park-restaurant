# Paste these values into .env.local for local development and Vercel Environment Variables for production.
# Never commit .env.local or paste these values in a chat.
SUPABASE_URL=https://evznljvmcjrrupyumkxl.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_SERVER_ONLY_KEY
# Optional notifications; requests still save to Supabase without these.
RESEND_API_KEY=
RESTAURANT_BOOKINGS_EMAIL=
BOOKING_FROM_EMAIL=reservations@your-verified-domain.co.za
# Required for public submissions in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: enforce Turnstile hostname matches your deployed production host.
PUBLIC_SITE_HOSTNAME=
# Local development ONLY, use true to test API without CAPTCHA. NEVER use in production.
ALLOW_UNPROTECTED_BOOKINGS=false
